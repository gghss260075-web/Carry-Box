rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['username', 'color', 'hat', 'shirt', 'pants']) &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.color is string && data.color.size() <= 32 &&
        data.hat is string && data.hat.size() <= 64 &&
        data.shirt is string && data.shirt.size() <= 64 &&
        data.pants is string && data.pants.size() <= 64;
    }

    function isValidMatchRecord(data, userId) {
      return data.keys().hasAll(['userId', 'mapId', 'modeId', 'winnerTeam']) &&
        data.userId == userId &&
        data.mapId is string && data.mapId.size() <= 64 &&
        data.modeId is string && data.modeId.size() <= 64 &&
        data.winnerTeam is string && data.winnerTeam.size() <= 32;
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isValidId(userId));
      allow list: if false; // Deny blanket listing of user profiles
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // Subcollection for match history
      match /matches/{matchId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(matchId) && isValidMatchRecord(incoming(), userId);
        allow update, delete: if false;
      }
    }
  }
}
